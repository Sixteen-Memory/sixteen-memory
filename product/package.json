{
  "name": "sixteen-memory-product",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start:local": "node scripts/start-local.mjs",
    "build": "tsc --noEmit && vite build && wrangler deploy --dry-run --outdir dist-worker",
    "types": "wrangler types",
    "test": "node --test test/*.test.mjs",
    "test:runtime": "node test/runtime.mjs",
    "test:round1": "node test/round1-runtime.mjs",
    "test:components": "node test/memory-components-runtime.mjs",
    "test:knowledge": "node test/knowledge-runtime.mjs",
    "test:wiki": "node test/wiki-runtime.mjs",
    "test:media": "node test/media-runtime.mjs",
    "test:media:upload": "node test/media-upload-runtime.mjs",
    "test:agent-access": "node test/agent-access-runtime.mjs",
    "agents": "node integrations/code-agents/cli.mjs",
    "test:python": "cd sdk-python && python3 -m unittest -v test_client",
    "test:python:runtime": "node test/python-runtime.mjs",
    "test:ecosystem": "node test/ecosystem-runtime.mjs",
    "prepare:local": "node scripts/prepare-local.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:migration": "node test/migration.mjs",
    "eval:preflight": "node eval/run.mjs",
    "test:oauth": "node test/oauth-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "eventsource-parser": "3.1.1",
    "lucide-react": "0.468.0",
    "music-metadata": "12.3.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "miniflare": "5.20261103.0-beta",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "wrangler": "4.157.0"
  }
}
