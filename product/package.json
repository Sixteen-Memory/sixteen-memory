    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "miniflare": "5.20261103.0-beta",
    "typescript": "5.9.3",
