{
  "name": "@sixteen-memory/vercel-ai",
  "version": "0.3.0",
  "description": "Scoped memory tools and retrieval middleware for the Vercel AI SDK.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "SECURITY.md",
    "examples/server.ts",
    "examples/offline.mjs",
    "examples/lifecycle.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run typecheck && node --test test/adapter.test.mjs test/framework.test.mjs test/handler.test.mjs",
    "test:runtime": "node test/runtime.mjs",
    "test:e2e": "npm run build && node examples/end-to-end.mjs",
    "test:package": "npm run build && node test/package.mjs",
    "test:console": "node test/console-runtime.mjs",
    "example": "npm run build && node examples/offline.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@sixteen-memory/sdk": "^0.3.0",
    "ai": "^7.0.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@sixteen-memory/sdk": "file:../../sdk",
    "@types/json-schema": "7.0.15",
    "@types/node": "22.19.0",
    "ai": "7.0.165",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
