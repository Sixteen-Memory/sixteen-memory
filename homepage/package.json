{
  "name": "sixteenmemory-homepage",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run prepare:sdk && tsc --noEmit && vite build && node scripts/build-routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "deploy:check": "npm run prepare:sdk && npm test && npm run build",
    "deploy": "npm run deploy:check && wrangler pages deploy dist --project-name sixteenmemory-homepage --branch main",
    "prepare:sdk": "node scripts/prepare-sdk.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
